<script type="module">

import {
    initializeApp
} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";

import {
    getAuth,
    onAuthStateChanged,
    signOut
} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js";

import {
    getDatabase,
    ref,
    get
} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-database.js";


const firebaseConfig = {

    apiKey:"AIzaSyD7McDVKP5QmZlcVBtmixK3Er9288rbeww",

    authDomain:"nzama-investment-2026.firebaseapp.com",

    databaseURL:
    "https://nzama-investment-2026-default-rtdb.firebaseio.com",

    projectId:"nzama-investment-2026",

    storageBucket:
    "nzama-investment-2026.firebasestorage.app",

    messagingSenderId:"1050465478535",

    appId:
    "1:1050465478535:web:dbdee6dfe598b644399522"
};


const app =
    initializeApp(firebaseConfig);

const auth =
    getAuth(app);

const db =
    getDatabase(app);


const loading =
    document.getElementById("loading");


function money(value){

    const number =
        Number(value || 0);

    return number.toLocaleString(
        "en-ZA",
        {
            style:"currency",
            currency:"ZAR",
            minimumFractionDigits:2
        }
    );

}


function maskAccount(account){

    if(!account){
        return "Not provided";
    }

    const text =
        String(account);

    if(text.length <= 4){
        return "••••" + text;
    }

    return "••••••" +
        text.slice(-4);

}


function setText(id,value){

    const element =
        document.getElementById(id);

    if(element){
        element.textContent =
            value ?? "—";
    }

}


function renderClient(data){

    data =
        data || {};

    const portfolio =
        data.portfolio || {};


    const invested =
        Number(
            portfolio.totalInvested || 0
        );

    const profit =
        Number(
            portfolio.profit || 0
        );

    const currentValue =
        Number(
            portfolio.currentValue ??
            invested + profit
        );


    /* TOP */

    setText(
        "topName",
        data.name || "Client"
    );


    /* STATS */

    setText(
        "portfolio",
        money(currentValue)
    );

    setText(
        "deposit",
        money(invested)
    );

    setText(
        "profit",
        money(profit)
    );


    /* PROFILE */

    setText(
        "pName",
        data.name || "—"
    );

    setText(
        "pGender",
        data.gender || "—"
    );

    setText(
        "pEmail",
        data.email || "—"
    );

    setText(
        "pPhone",
        data.phone || "—"
    );

    setText(
        "pAddress",
        data.address || "—"
    );

    setText(
        "pAdmin",
        data.administrator || "—"
    );

    setText(
        "pStatus",
        data.accountStatus || "Active"
    );


    /* PORTFOLIO */

    setText(
        "circleVal",
        money(currentValue)
    );

    setText(
        "oDeposit",
        money(invested)
    );

    setText(
        "oProfit",
        money(profit)
    );

    setText(
        "depositDate",
        data.investmentDate || "—"
    );


    /* ACCOUNT */

    setText(
        "plan",
        data.plan || "—"
    );

    setText(
        "planAmount",
        money(invested)
    );

    setText(
        "planProfit",
        money(profit)
    );

    setText(
        "planTotal",
        money(currentValue)
    );

    setText(
        "term",
        data.term || "—"
    );

    setText(
        "accountNumber",
        maskAccount(data.accountNumber)
    );

    setText(
        "bank",
        data.bank || "—"
    );

    setText(
        "investmentDate",
        data.investmentDate || "—"
    );


    /* TRANSACTIONS */

    setText(
        "transactionDate",
        data.investmentDate || "—"
    );

    setText(
        "transactionInvestment",
        money(invested)
    );

    setText(
        "transactionProfit",
        "+" + money(profit)
    );

    setText(
        "transactionTotal",
        money(currentValue)
    );

}


/* AUTHENTICATION */

onAuthStateChanged(
    auth,
    async(user)=>{

        if(!user){

            window.location.href =
                "login.html";

            return;
        }


        try{

            /*
             IMPORTANT:
             The logged-in Firebase UID determines
             which database record is loaded.
            */

            const userRef =
                ref(
                    db,
                    "users/" + user.uid
                );

            const snapshot =
                await get(userRef);


            if(snapshot.exists()){

                const data =
                    snapshot.val();

                renderClient(data);

            }else{

                /*
                 If the account exists in Firebase
                 Authentication but its database
                 profile does not exist yet.
                */

                renderClient({

                    name:user.displayName || "Client",

                    email:user.email || "",

                    accountStatus:"Active",

                    portfolio:{
                        totalInvested:0,
                        profit:0,
                        currentValue:0
                    }

                });

            }


        }catch(error){

            console.error(
                "Database error:",
                error
            );

            alert(
                "Unable to load your account information."
            );

        }


        loading.style.display =
            "none";

    }
);


/* LOGOUT */

document
.getElementById("logoutBtn")
.addEventListener(
    "click",
    async()=>{

        try{

            await signOut(auth);

            window.location.href =
                "login.html";

        }catch(error){

            console.error(error);

        }

    }
);

</script>

</body>
</html>