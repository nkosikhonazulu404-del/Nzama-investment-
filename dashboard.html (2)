<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>NZAMA INVESTMENT | Client Dashboard</title>

<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

:root{
    --navy:#050b18;
    --navy2:#08152b;
    --panel:#0b1830;
    --panel2:#0e1e3a;
    --gold:#d4af37;
    --gold2:#f2d477;
    --purple:#7b35ff;
    --blue:#2764d8;
    --white:#fff;
    --muted:#aab6ca;
    --green:#39d98a;
    --red:#ff6675;
    --border:rgba(255,255,255,.08);
}

body{
    margin:0;
    min-height:100vh;
    font-family:Inter,Arial,sans-serif;
    background:
        radial-gradient(circle at 80% 10%,rgba(123,53,255,.15),transparent 30%),
        linear-gradient(135deg,var(--navy),var(--navy2));
    color:white;
}

.layout{
    display:flex;
    min-height:100vh;
}

/* SIDEBAR */

.sidebar{
    width:250px;
    flex-shrink:0;
    background:rgba(5,11,24,.96);
    border-right:1px solid var(--border);
    padding:25px 17px;
    position:fixed;
    left:0;
    top:0;
    bottom:0;
    z-index:10;
}

.logo{
    display:flex;
    align-items:center;
    gap:11px;
    padding:0 10px 30px;
}

.logo-icon{
    width:43px;
    height:43px;
    border-radius:13px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:900;
    font-size:22px;
    background:linear-gradient(135deg,var(--purple),var(--blue),var(--gold));
}

.logo-text{
    font-size:18px;
    font-weight:900;
    letter-spacing:1px;
}

.logo-text small{
    display:block;
    font-size:9px;
    color:var(--gold2);
    letter-spacing:3px;
}

.nav-title{
    color:#61718c;
    font-size:10px;
    letter-spacing:2px;
    padding:0 12px;
    margin:12px 0;
}

.nav a,
.logout{
    width:100%;
    display:flex;
    align-items:center;
    gap:12px;
    padding:12px;
    margin-bottom:5px;
    border-radius:10px;
    text-decoration:none;
    color:var(--muted);
    font-size:13px;
    cursor:pointer;
    border:0;
    background:transparent;
    text-align:left;
}

.nav a:hover,
.nav a.active,
.logout:hover{
    color:white;
    background:rgba(212,175,55,.08);
}

.nav a.active{
    border-left:3px solid var(--gold);
}

.icon{
    width:22px;
    text-align:center;
}

.logout{
    margin-top:25px;
    color:#ff8d98;
}

/* MAIN */

.main{
    width:calc(100% - 250px);
    margin-left:250px;
    min-width:0;
}

.topbar{
    min-height:75px;
    padding:17px 30px;
    border-bottom:1px solid var(--border);
    background:rgba(5,11,24,.65);
    backdrop-filter:blur(12px);
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
}

.welcome{
    font-size:18px;
    font-weight:800;
}

.welcome small{
    display:block;
    margin-top:4px;
    font-size:11px;
    color:var(--muted);
    font-weight:400;
}

.status{
    display:flex;
    align-items:center;
    gap:8px;
    padding:8px 12px;
    border:1px solid rgba(57,217,138,.2);
    border-radius:30px;
    background:rgba(57,217,138,.06);
    color:#79eab0;
    font-size:11px;
}

.dot{
    width:7px;
    height:7px;
    background:var(--green);
    border-radius:50%;
}

/* CONTENT */

.content{
    max-width:1250px;
    margin:auto;
    padding:30px;
}

.page-title{
    margin-bottom:25px;
}

.page-title h1{
    font-size:28px;
    margin-bottom:7px;
}

.page-title p{
    color:var(--muted);
    font-size:13px;
}

/* CARDS */

.stats{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
    margin-bottom:25px;
}

.card{
    background:rgba(11,24,48,.9);
    border:1px solid var(--border);
    border-radius:17px;
    padding:21px;
}

.stat-card{
    position:relative;
    overflow:hidden;
}

.stat-card:after{
    content:"";
    position:absolute;
    width:90px;
    height:90px;
    right:-30px;
    bottom:-30px;
    background:rgba(212,175,55,.06);
    border-radius:50%;
}

.label{
    color:var(--muted);
    font-size:12px;
    margin-bottom:10px;
}

.value{
    font-size:27px;
    font-weight:900;
}

.gold{
    color:var(--gold2);
}

.green{
    color:var(--green);
}

/* GRID */

.grid{
    display:grid;
    grid-template-columns:2fr 1fr;
    gap:20px;
    margin-bottom:20px;
}

.card-title{
    font-size:16px;
    font-weight:800;
    margin-bottom:18px;
}

.profile-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:15px;
}

.field{
    background:rgba(255,255,255,.025);
    border-radius:10px;
    padding:12px;
}

.field label{
    display:block;
    color:#70809b;
    font-size:10px;
    margin-bottom:5px;
    text-transform:uppercase;
    letter-spacing:.7px;
}

.field strong{
    font-size:13px;
    font-weight:600;
    word-break:break-word;
}

.investment{
    text-align:center;
}

.portfolio-circle{
    width:190px;
    height:190px;
    margin:5px auto 20px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    background:
        radial-gradient(circle,var(--panel) 61%,transparent 62%),
        conic-gradient(var(--gold) 0 72%,var(--purple) 72% 100%);
}

.circle-inner strong{
    display:block;
    font-size:23px;
}

.circle-inner span{
    display:block;
    color:var(--muted);
    font-size:11px;
    margin-top:4px;
}

.rows{
    border-top:1px solid var(--border);
}

.row{
    display:flex;
    justify-content:space-between;
    gap:15px;
    padding:12px 0;
    border-bottom:1px solid var(--border);
    font-size:12px;
}

.row span:first-child{
    color:var(--muted);
}

.row strong{
    text-align:right;
}

/* INFORMATION */

.info-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:14px;
}

.info{
    padding:14px;
    background:rgba(255,255,255,.025);
    border-radius:10px;
}

.info span{
    display:block;
    color:#70809b;
    font-size:10px;
    margin-bottom:5px;
}

.info strong{
    font-size:13px;
}

/* TRANSACTIONS */

.transaction{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    padding:15px 0;
    border-bottom:1px solid var(--border);
}

.transaction:last-child{
    border-bottom:0;
}

.transaction-name{
    font-size:13px;
    font-weight:700;
}

.transaction-date{
    color:#71819b;
    font-size:10px;
    margin-top:4px;
}

.transaction-amount{
    font-weight:800;
}

.positive{
    color:var(--green);
}

/* NOTICE */

.notice{
    border:1px solid rgba(212,175,55,.2);
    background:rgba(212,175,55,.045);
    color:#d9c98c;
    border-radius:13px;
    padding:15px;
    font-size:11px;
    line-height:1.6;
    margin-top:20px;
}

/* LOADING */

#loading{
    position:fixed;
    inset:0;
    background:#050b18;
    z-index:100;
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column;
}

.spinner{
    width:40px;
    height:40px;
    border:3px solid #263652;
    border-top-color:var(--gold);
    border-radius:50%;
    animation:spin 1s linear infinite;
    margin-bottom:15px;
}

@keyframes spin{
    to{transform:rotate(360deg)}
}

/* MOBILE */

@media(max-width:950px){

    .sidebar{
        width:215px;
    }

    .main{
        width:calc(100% - 215px);
        margin-left:215px;
    }

    .stats{
        grid-template-columns:1fr;
    }

    .grid{
        grid-template-columns:1fr;
    }
}

@media(max-width:700px){

    .sidebar{
        position:relative;
        width:100%;
        height:auto;
        bottom:auto;
        padding:15px;
    }

    .layout{
        display:block;
    }

    .nav{
        display:none;
    }

    .logo{
        padding-bottom:5px;
    }

    .main{
        width:100%;
        margin-left:0;
    }

    .topbar{
        padding:15px 18px;
    }

    .content{
        padding:20px 15px;
    }

    .profile-grid,
    .info-grid{
        grid-template-columns:1fr;
    }

    .status{
        display:none;
    }
}

</style>

</head>

<body>

<div id="loading">

    <div class="spinner"></div>

    <div>
        Loading secure dashboard...
